# LLM 配置（兼容 OpenAI API 格式的服务均可）
# Ollama 本地部署: 先执行 `ollama pull qwen2:0.5b` 并启动 ollama serve
# 如需切换其他 OpenAI 兼容服务，修改 LLM_BASE_URL 和 LLM_MODEL 即可
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2:0.5b

# RAGAS 评估：Instructor 结构化输出上限（Faithfulness/context 等指标易超限截断）；按模型服务端实际上限可调
# RAGAS_LLM_MAX_TOKENS=8192

# Milvus 配置
# Linux/macOS 可使用 Lite 本地文件；Windows 请启动 Milvus Docker 后改为
# PRIVATE_RAG_MILVUS_URI=http://localhost:19530
# 避免用 MILVUS_URI（pymilvus 内部也读这个环境变量，会冲突）
PRIVATE_RAG_MILVUS_URI=./private_rag_milvus.db

# Embedding 模型配置
# 可选: BAAI/bge-large-zh-v1.5 (1024维), BAAI/bge-small-zh-v1.5 (512维, 速度更快)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# Windows 建议显式放到非系统盘，避免默认下载到 C:\Users\<用户>\.cache
HF_HOME=E:/AIModels/huggingface
SENTENCE_TRANSFORMERS_HOME=E:/AIModels/huggingface/sentence-transformers

# 稠密向量检索：Milvus COSINE 相似度下限（0~1），低于则丢弃；0 表示关闭阈值过滤
# DENSE_MIN_SIMILARITY=0.30

# 检索候选、生成上下文和本地 CrossEncoder 重排
# RETRIEVAL_CANDIDATE_TOP_K=20
# GENERATION_CONTEXT_TOP_K=5
# ENABLE_RERANKER=true
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_DEVICE=cpu
# RERANKER_BATCH_SIZE=16
# RERANKER_RELEVANCE_THRESHOLD=0.50
# RETRIEVAL_ACCEPT_TOP1_THRESHOLD=0.60
# RETRIEVAL_GATE_MODE=enforce
# MAX_RETRIES=2

# HuggingFace 镜像（国内网络需要配置）
HF_ENDPOINT=https://hf-mirror.com

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Redis 检索缓存（Docker Compose 默认密码为 1234）
REDIS_ENABLED=true
REDIS_URL=redis://:1234@localhost:6379/0
REDIS_CACHE_TTL=1800
REDIS_KEY_PREFIX=private-rag
